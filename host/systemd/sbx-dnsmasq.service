[Unit]
Description=Sandbox sink DHCP + wildcard DNS (inside sbxsink)
Requires=sbx-net.service
After=sbx-net.service
PartOf=sbx-net.service

[Service]
NetworkNamespacePath=/run/netns/sbxsink
RuntimeDirectory=sbx-dnsmasq
ExecStart=/usr/sbin/dnsmasq -k --conf-file=/opt/sbx/sink/dnsmasq.conf --log-facility=-
Restart=on-failure
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/sbx-dnsmasq
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN CAP_NET_RAW CAP_SETUID CAP_SETGID CAP_CHOWN

[Install]
WantedBy=multi-user.target
